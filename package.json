{
  "name": "nanite-video",
  "version": "1.0.0-workprint",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ClusterDagDemo out/cluster-dag-demo.mp4",
    "still": "remotion still src/index.ts ClusterDagDemo out/cover.png --frame=675",
    "check": "tsc --noEmit",
    "validate:geometry": "node --experimental-strip-types src/demoData.ts",
    "render:episode01": "remotion render src/index.ts Episode01Workprint out/episode-01-workprint.mp4",
    "still:episode01": "remotion still src/index.ts Episode01Workprint out/episode-01-clusters.png --frame=2010",
    "still:episode01-local": "remotion still src/index.ts Episode01Workprint out/episode-01-local-lod.png --frame=1830",
    "validate:episode01": "node --experimental-strip-types src/episode01/ch01Geometry.ts",
    "validate:chapter02": "node --experimental-strip-types src/episode01/ch02Graph.ts",
    "still:episode01-graph": "remotion still src/index.ts Episode01Workprint out/episode-01-graph.png --frame=2610",
    "still:episode01-partition": "remotion still src/index.ts Episode01Workprint out/episode-01-partition.png --frame=2810",
    "still:episode01-clusters-ch02": "remotion still src/index.ts Episode01Workprint out/episode-01-ch02-clusters.png --frame=3110",
    "validate:hierarchy": "node --experimental-strip-types src/episode01/ch03Hierarchy.ts",
    "validate:all": "npm run validate:geometry && npm run validate:episode01 && npm run validate:chapter02 && npm run validate:hierarchy && npm run validate:dag-cut && npm run validate:traditional-lod",
    "still:episode01-group": "remotion still src/index.ts Episode01Workprint out/episode-01-group.png --frame=3720",
    "still:episode01-dag": "remotion still src/index.ts Episode01Workprint out/episode-01-dag.png --frame=5490",
    "still:episode01-error": "remotion still src/index.ts Episode01Workprint out/episode-01-error.png --frame=7350",
    "still:episode01-runtime": "remotion still src/index.ts Episode01Workprint out/episode-01-runtime.png --frame=9660",
    "still:episode01-outro": "remotion still src/index.ts Episode01Workprint out/episode-01-outro.png --frame=10150",
    "render:episode01-preview": "remotion render src/index.ts Episode01Workprint out/episode-01-complete-preview.mp4 --scale=0.5 --crf=24",
    "validate:dag-cut": "node --experimental-strip-types src/episode01/lodDagTeaching.ts",
    "still:episode01-multilevel-dag": "remotion still src/index.ts Episode01Workprint out/episode-01-multilevel-dag.png --frame=6240",
    "still:episode01-versions": "remotion still src/index.ts Episode01Workprint out/episode-01-lod-versions.png --frame=250",
    "still:episode01-camera-lod": "remotion still src/index.ts Episode01Workprint out/episode-01-camera-lod.png --frame=690",
    "still:episode01-wall": "remotion still src/index.ts Episode01Workprint out/episode-01-wall-transition.png --frame=1380",
    "still:episode01-pixels": "remotion still src/index.ts Episode01Workprint out/episode-01-pixel-grid.png --frame=1610",
    "validate:traditional-lod": "node --experimental-strip-types src/episode01/traditionalLod.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.541",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.8.3"
  }
}
